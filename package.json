{
  "name": "zecstats",
  "version": "0.1.0",
  "private": true,
  "description": "ZEC Stats redesign — Next.js app using a snapshot of zecstats.com as mock data",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
