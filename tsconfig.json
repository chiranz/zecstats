{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-lead/types/**/*.ts",
    ".next-lead/dev/types/**/*.ts",
    ".next-a1/types/**/*.ts",
    ".next-a1/dev/types/**/*.ts",
    ".next-a2/types/**/*.ts",
    ".next-a2/dev/types/**/*.ts",
    ".next-b1/types/**/*.ts",
    ".next-b1/dev/types/**/*.ts",
    ".next-b2/types/**/*.ts",
    ".next-b2/dev/types/**/*.ts",
    ".next-c/types/**/*.ts",
    ".next-c/dev/types/**/*.ts",
    ".next-d/types/**/*.ts",
    ".next-d/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-tk/types/**/*.ts",
    ".next-tk/dev/types/**/*.ts",
    ".next-nl/types/**/*.ts",
    ".next-nl/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "data",
    ".next*"
  ]
}
